{
  "manifest_version": 3,
  "name": "TopFeed Pro — Ordená Instagram, TikTok y Facebook",
  "short_name": "TopFeed Pro",
  "version": "1.0.0",
  "description": "Ordená posts y reels por vistas, likes, comentarios, compartidos y engagement. Outliers, análisis, exportación a Excel/CSV/Sheets e ideas con IA.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup/popup.html", "default_title": "TopFeed Pro" },
  "options_page": "options/options.html",
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "host_permissions": [
    "https://*.instagram.com/*", "https://*.cdninstagram.com/*",
    "https://*.facebook.com/*", "https://*.fbcdn.net/*",
    "https://*.tiktok.com/*", "https://*.tiktokcdn.com/*", "https://*.tiktokcdn-us.com/*", "https://*.tiktokv.com/*",
    "https://*.byteoversea.com/*", "https://*.ibytedtos.com/*",
    "https://api.anthropic.com/*", "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.facebook.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.facebook.com/*"],
      "js": ["src/extract.js", "src/analytics.js", "src/styles.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
